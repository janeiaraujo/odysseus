#!/usr/bin/env bash
# jarvis-update: encrypted backup, then fast-forward from YOUR fork, rebuild, check.
# Only `origin` is used. Upstream is never fetched into your branch automatically.
#   scripts/jarvis-update --key-file ~/jarvis-recovery.key
set -euo pipefail
cd "$(dirname "$0")/.."
KEY="${2:-$HOME/jarvis-recovery.key}"
[ -f "$KEY" ] || { echo "erro: chave nao encontrada: $KEY" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "erro: ha alteracoes locais; commite antes de atualizar" >&2; exit 1; }

PY=python3
[ -x venv/bin/python ] && PY=venv/bin/python
"$PY" scripts/jarvis-backup create --key-file "$KEY"
git pull --ff-only origin "$(git branch --show-current)"
docker compose up -d --build
for _ in $(seq 1 60); do
  curl -fs -m 2 "http://127.0.0.1:${APP_PORT:-7000}/api/health" >/dev/null && break
  sleep 2
done
python3 scripts/jarvis-doctor
